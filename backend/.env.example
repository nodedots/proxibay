# Stackduck API (NestJS + Postgres/TimescaleDB) — local dev config.
# Copy to .env and fill in. Never commit real values.
PORT=3001
# Postgres / TimescaleDB (matches docker-compose.yml service `db`)
DATABASE_URL=postgres://stackduck:stackduck@localhost:5433/stackduck
# Require TimescaleDB extension. If the connected Postgres lacks Timescale,
# the API still boots: MetricPoint falls back to a plain table + btree index
# and time_bucket() rollups fall back to date_trunc(). Set to "true" to fail
# fast instead when the extension is missing.
REQUIRE_TIMESCALE=false
# JWT session handling (access + refresh)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# App-level encryption for connector secrets (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# OAuth (callback URLs point at THIS backend, not Firebase — Phase 3 cutover)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/v1/auth/github/callback
# Frontend origin for CORS + OAuth redirects
PUBLIC_APP_URL=http://localhost:5173
# Alert email delivery via Resend (Alerting Model email channel).
# Leave blank locally to log instead of send; set on Railway/staging.
RESEND_API_KEY=
ALERT_FROM_EMAIL=Stackduck <onboarding@resend.dev>
# Enables POST /v1/internal/jobs/* manual triggers (verification only).
# Leave unset in production — the route 404s when this is empty.
JOBS_TRIGGER_SECRET=

